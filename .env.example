# API under test. Only the isolated test environment (port 18080) is allowed unless
# VERIFYFLOW_ALLOW_NON_ISOLATED_TARGET=true is set explicitly.
ORDERFLOW_BASE_URL=http://127.0.0.1:18080

# Local OrderFlow checkout used to build the test environment.
ORDERFLOW_SOURCE_DIR=../orderFlow-backend

# Test-only values for the disposable environment. Never reuse real credentials.
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=
ORDERFLOW_JWT_SECRET=
ORDERFLOW_ADMIN_EMAIL=admin@verifyflow.test
ORDERFLOW_ADMIN_PASSWORD=
